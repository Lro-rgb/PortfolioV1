# Umgebungsvariablen — nach .env kopieren und ausfuellen.
# Beide Werte sind Pflicht. Fehlt einer, antwortet der geschuetzte
# Bereich bewusst mit 503, statt auf einen Standardwert zurueckzufallen.
#
# In Produktion setzen mit:
#   vercel env add JWT_SECRET
#   vercel env add APP_PASSWORD_HASH

# Mindestens 32 Zeichen. Erzeugen mit:
#   node scripts/generate-jwt-secret.js
JWT_SECRET=

# Format "salt:hash" (beides hex). Erzeugen mit:
#   node scripts/generate-password-hash.js DEIN_PASSWORT
APP_PASSWORD_HASH=

# 64 Hexzeichen. Entschluesselt die Kompetenznachweise in
# unterlagen-verschluesselt/ — ohne ihn antwortet /api/zeugnis mit 503.
# Erzeugen laesst ihn sich beim ersten Aufruf von:
#   node scripts/unterlagen-verschluesseln.js
UNTERLAGEN_KEY=

# Personalien im Lebenslauf (Geburtsdatum, Wohnadresse, Telefon,
# Staatsangehoerigkeit). Sie gehoeren nicht in api/protected.js, weil dieses
# Repository oeffentlich ist. Was hier leer bleibt, erscheint im Lebenslauf
# gar nicht — es entsteht also keine leere Zeile.
#   vercel env add CV_GEBURTSDATUM
CV_GEBURTSDATUM=
CV_ADRESSE=
CV_TELEFON=
CV_NATIONALITAET=
