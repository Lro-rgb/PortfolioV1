# Umgebungsvariablen — nach .env kopieren und ausfuellen.
# Beide Werte sind Pflicht. Fehlt einer, antwortet der geschuetzte
# Bereich bewusst mit 503, statt auf einen Standardwert zurueckzufallen.
#
# In Produktion setzen mit:
#   vercel env add JWT_SECRET
#   vercel env add APP_PASSWORD_HASH

# Mindestens 32 Zeichen. Erzeugen mit:
#   node scripts/generate-jwt-secret.js
JWT_SECRET=

# Format "salt:hash" (beides hex). Erzeugen mit:
#   node scripts/generate-password-hash.js DEIN_PASSWORT
APP_PASSWORD_HASH=
